<% if (success) { %>
  <div class="success"><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="error"><%= error %></div>
<% } %>

<p>Shown as a permanent popup on the frontend. Leave empty to show nothing.</p>

<form method="POST" action="/admin/status-message" class="settings-form">
  <label>Message
    <textarea name="message" rows="6"><%= message %></textarea>
  </label>
  <button type="submit">Save</button>
</form>
